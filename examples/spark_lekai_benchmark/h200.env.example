# Copy this file or source these exports before running the Spark/H200 benchmark.

export CUDA_VISIBLE_DEVICES=0
export PYTHON_BIN=python
export OUT_ROOT=spark_runs/lekai_h200_$(date +%Y%m%d_%H%M%S)

# Override these if Spark stores checkpoints outside the repository defaults.
export PROMPT_CKPT=models/hf/RT-accompanimentV2-checkpoints/lekai_prompt_model/model.safetensors
export CONT_CKPT=models/hf/RT-accompanimentV2-checkpoints/lekai_continuation_model/model.safetensors

# Default test MIDI.
export MIDI_FILE=prompts/A_major/pop909_291_mel.mid

# Main timing setup.
export BPM=120
export PROMPT_LENGTH_TICKS=32
export GEN_INTERVAL_TICKS=4
export GEN_LENGTH_FRAMES=4

# Sample counts.
export PROMPT_REPEATS=3
export CONT_REQUESTS=80

# Set to 0 for direct model/scheduler only.
export RUN_PUBLIC_CLIENT=1

