+def _build_processor_batch(
+    processor: Any,
+    state: MossTTSState,
+    reference_encoder: Any = None,
+) -> Any:
+    if state.prefix_audio is None:
+        message = _build_processor_message(processor, state, reference_encoder)
+        return processor([[message]], mode="generation")
+    # Continuation: the user turn holds prefix + new text, the assistant turn
+    # the prefix codes, and generation resumes after the prefix audio.
+    prefix_codes = (
+        reference_encoder.encode(state.prefix_audio)
+        if reference_encoder is not None
+        else processor.encode_audios_from_path([state.prefix_audio])[0]
+    )
+    tokens = (
+        None
+        if state.token_count is None
+        else int(state.token_count) + int(prefix_codes.shape[0])
+    )
+    message = _build_processor_message(
+        processor,
+        state,
+        reference_encoder,
+        text=f"{state.prefix_text} {state.text}",
+        tokens=tokens,
+    )
+    assistant = processor.build_assistant_message(audio_codes_list=[prefix_codes])
+    return processor([[message, assistant]], mode="continuation")
+
