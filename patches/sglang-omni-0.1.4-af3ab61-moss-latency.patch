+def _cancel_watcher_task(task: asyncio.Task[Any]) -> None:
+    """Cancel a disconnect watcher without waiting for it to finish.
+
+    StreamMUSE latency patch: the watcher only polls ``request.is_disconnected()``
+    and owns no engine or GPU state, so the response need not wait (up to
+    ``HTTP_DISCONNECT_CANCEL_TIMEOUT_S``) for its cancellation to land; an
+    occasional slow cancel otherwise delays a finished response by 100 ms.
+    Generation tasks keep the bounded wait in ``_cancel_task_bounded``.
+    """
+    task.cancel()
+    task.add_done_callback(_discard_cancelled_task_result)
+
+
 def _discard_cancelled_task_result(task: asyncio.Task[Any]) -> None:
     try:
         task.result()
