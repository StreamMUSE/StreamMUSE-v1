+    def _compute_control_text_logits(
+        self, hidden_states: torch.Tensor
+    ) -> torch.Tensor | None:
+        """Text logits for the two control tokens only, or ``None`` to fall back.
+
+        StreamMUSE latency patch: mirrors ``LogitsProcessor._get_logits`` for a
+        plain unquantized single-GPU text head (same lm-head dtype path, in-place
+        ``logit_scale`` and float32 result) but multiplies only the two control
+        rows instead of the 155k-row vocabulary before ``index_select``.
+        """
+        processor = self.logits_processors[0]
+        head = self.lm_heads[0]
+        weight = getattr(head, "weight", None)
+        if (
+            not isinstance(weight, torch.Tensor)
+            or processor.final_logit_softcapping
+            or getattr(processor, "do_tensor_parallel_all_gather", False)
+            or getattr(processor, "do_tensor_parallel_all_gather_dp_attn", False)
+            or getattr(processor, "rl_on_policy_target", None) is not None
+            or (hasattr(head, "set_lora") and hasattr(head, "apply_lora"))
+            or should_apply_lm_head_quant_method(head, getattr(head, "quant_method", None))
+            or use_intel_amx_backend(head)
+        ):
+            return None
+        if (
+            self._text_control_head_weight is None
+            or self._text_control_head_source_ptr != weight.data_ptr()
+        ):
+            token_ids = self._text_control_token_ids.to(device=weight.device)
+            self._text_control_head_weight = weight.index_select(0, token_ids).contiguous()
+            self._text_control_head_source_ptr = weight.data_ptr()
+        control = self._text_control_head_weight
+        if processor.use_fp32_lm_head:
+            if (
+                hidden_states.is_cuda
+                and hidden_states.dtype == control.dtype
+                and hidden_states.dtype in (torch.float16, torch.bfloat16)
+            ):
+                logits = torch.mm(hidden_states, control.T, out_dtype=torch.float32)
+            else:
+                logits = torch.matmul(
+                    hidden_states.to(torch.float32), control.to(torch.float32).T
+                )
+        else:
+            logits = torch.matmul(hidden_states.to(control.dtype), control.T)
+        if processor.logit_scale is not None:
+            logits.mul_(processor.logit_scale)
+        return logits.float()
 
