+    @staticmethod
+    def _stacked_audio_embeddings_eligible(layers: list[Any]) -> bool:
+        weights = [getattr(layer, "weight", None) for layer in layers]
+        if not layers or any(not isinstance(w, torch.Tensor) or w.dim() != 2 for w in weights):
+            return False
+        first = weights[0]
+        return all(
+            isinstance(layer, VocabParallelEmbedding)
+            and int(getattr(layer, "tp_size", 1)) == 1
+            and type(getattr(layer, "quant_method", None)).__name__
+            == "UnquantizedEmbeddingMethod"
+            and weight.shape == first.shape
+            and weight.dtype == first.dtype
+            and weight.device == first.device
+            for layer, weight in zip(layers, weights)
+        )
+
+    def _ensure_stacked_audio_embeddings(self, *, allow_copy: bool) -> None:
+        """Back the 32 audio embedding tables with one stacked buffer.
+
+        Like the fused audio heads, each table is re-pointed at a slice of the
+        stacked buffer, so this adds no steady-state memory. A weight-share
+        follower (``allow_copy=False``) only views the leader's storage and
+        falls back to per-table lookups when it is not one block, which gives
+        the same bits either way.
+        """
+        self._stacked_audio_embed_weight = None
+        self._stacked_audio_embed_offsets = None
+        self._audio_embed_expected_ptrs = []
+        layers = list(self.embedding_list[1:])
+        if not self._stacked_audio_embeddings_eligible(layers):
+            logger.info("MOSS-TTS stacked audio embeddings disabled (unsupported configuration)")
+            return
+        weights = [layer.weight for layer in layers]
+        rows = int(weights[0].shape[0])
+        stacked = self._stacked_view_over_heads(weights)
+        if stacked is None:
+            if not allow_copy:
+                logger.info("MOSS-TTS stacked audio embeddings disabled (shared storage not one block)")
+                return
+            stacked = torch.cat([w.data for w in weights], dim=0).contiguous()
+            for index, layer in enumerate(layers):
+                layer.weight.data = stacked[index * rows : (index + 1) * rows]
+        self._stacked_audio_embed_weight = stacked
+        self._stacked_audio_embed_offsets = torch.arange(
+            len(layers), device=stacked.device, dtype=torch.long
+        ) * rows
+        self._audio_embed_expected_ptrs = [
+            layer.weight.data_ptr() for layer in layers
+        ]
+        logger.info(
+            "MOSS-TTS stacked audio embeddings enabled (stacked %s)", tuple(stacked.shape)
+        )
 
+    def _stacked_audio_embeddings_ready(self) -> bool:
+        if self._stacked_audio_embed_weight is None:
+            return False
+        for index, layer in enumerate(self.embedding_list[1:]):
+            weight = getattr(layer, "weight", None)
+            if weight is None or weight.data_ptr() != self._audio_embed_expected_ptrs[index]:
+                logger.warning(
+                    "MOSS-TTS stacked audio embeddings disabled: table %d was replaced",
+                    index + 1,
+                )
+                self._stacked_audio_embed_weight = None
+                return False
+        return True
